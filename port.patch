index 0000000..6ff5236
--- /dev/null
+++ b/Scripts/tests/test_verify_ipa.py
@@ -0,0 +1,95 @@
+import importlib.util
+import pathlib
+import plistlib
+import struct
+import tempfile
+import unittest
+import zipfile
+
+MODULE = pathlib.Path(__file__).resolve().parents[1] / 'verify-ipa.py'
+spec = importlib.util.spec_from_file_location('verify_ipa', MODULE)
+verify = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(verify)
+
+
+def binary(platform=2, signed=False):
+    commands = struct.pack('<6I', 0x32, 24, platform, 0x1A0000, 0x1A0500, 0)
+    if signed:
+        commands += struct.pack('<4I', 0x1D, 16, 80, 32)
+    return struct.pack('<8I', 0xFEEDFACF, 0x100000C, 0, 2, 2 if signed else 1, len(commands), 0, 0) + commands
+
+
+class IPAValidationTests(unittest.TestCase):
+    def make_ipa(self, entries=None, platform=2, signed=False, extension_id=None, executable_mode=0o100755):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        output = pathlib.Path(temporary.name) / 'test.ipa'
+        main = 'Payload/Test.app/'
+        info = {
+            'CFBundleIdentifier': 'org.example.test', 'CFBundleExecutable': 'Test',
+            'CFBundleShortVersionString': '0.1', 'MinimumOSVersion': '26.0',
+            'CFBundleSupportedPlatforms': ['iPhoneOS']
+        }
+        records = {main + 'Info.plist': plistlib.dumps(info), main + 'Test': binary(platform, signed)}
+        if extension_id:
+            extension = main + 'PlugIns/Share.appex/'
+            records[extension + 'Info.plist'] = plistlib.dumps({**info, 'CFBundleIdentifier': extension_id})
+            records[extension + 'Test'] = binary()
+        records.update(entries or {})
+        with zipfile.ZipFile(output, 'w') as archive:
+            for name, data in records.items():
+                member = zipfile.ZipInfo(name)
+                member.create_system = 3
+                member.external_attr = (executable_mode if name.endswith('/Test') else 0o100644) << 16
+                archive.writestr(member, data)
+        return output
+
+    def test_accepts_unsigned_arm64_device_bundle(self):
+        result = verify.validate(self.make_ipa(extension_id='org.example.test.share'))
+        self.assertEqual(result['app'], 'org.example.test')
+        self.assertEqual(len(result['bundles']), 2)
+
+    def test_rejects_simulator(self):
+        with self.assertRaisesRegex(ValueError, 'device platform'):
+            verify.validate(self.make_ipa(platform=7))
+
+    def test_rejects_code_signature(self):
+        with self.assertRaisesRegex(ValueError, 'code signature'):
+            verify.validate(self.make_ipa(signed=True))
+
+    def test_rejects_embedded_profile(self):
+        with self.assertRaisesRegex(ValueError, 'Signing metadata'):
+            verify.validate(self.make_ipa({'Payload/Test.app/embedded.mobileprovision': b'profile'}))
+
+    def test_rejects_signature_directory(self):
+        with self.assertRaisesRegex(ValueError, 'Signing metadata'):
+            verify.validate(self.make_ipa({'Payload/Test.app/_CodeSignature/CodeResources': b'signature'}))
+
+    def test_rejects_extension_id_mismatch(self):
+        with self.assertRaisesRegex(ValueError, 'Extension Bundle ID'):
+            verify.validate(self.make_ipa(extension_id='org.other.share'))
+
+    def test_rejects_non_executable_app(self):
+        with self.assertRaisesRegex(ValueError, 'permission'):
+            verify.validate(self.make_ipa(executable_mode=0o100644))
+
+    def test_rejects_zip_path_traversal(self):
+        with self.assertRaisesRegex(ValueError, 'Unsafe IPA member'):
+            verify.validate(self.make_ipa({'Payload/../../outside': b'bad'}))
+
+    def test_rejects_x86_binary(self):
+        with self.assertRaisesRegex(ValueError, 'arm64'):
+            verify.macho_info(struct.pack('<8I', 0xFEEDFACF, 0x1000007, 0, 2, 0, 0, 0, 0))
+
+    def test_rejects_corrupt_load_command(self):
+        with self.assertRaisesRegex(ValueError, 'load-command'):
+            verify.macho_info(struct.pack('<8I', 0xFEEDFACF, 0x100000C, 0, 2, 1, 8, 0, 0)
+                              + struct.pack('<2I', 0x32, 4))
+
+    def test_rejects_signed_embedded_library(self):
+        with self.assertRaisesRegex(ValueError, 'code signature'):
+            verify.validate(self.make_ipa({'Payload/Test.app/Frameworks/Bad.dylib': binary(signed=True)}))
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/Scripts/verify-ipa.py b/Scripts/verify-ipa.py
new file mode 100644
index 0000000..9e504b5
--- /dev/null
+++ b/Scripts/verify-ipa.py
@@ -0,0 +1,96 @@
+"""Validate a real-device, unsigned iOS IPA without requiring macOS."""
+import json
+import pathlib
+import plistlib
+import stat
+import struct
+import sys
+import zipfile
+
+ARM64 = 0x0100000C
+MACHO64 = 0xFEEDFACF
+LC_CODE_SIGNATURE = 0x1D
+LC_BUILD_VERSION = 0x32
+
+
+def macho_info(data):
+    if len(data) < 32:
+        raise ValueError('Truncated Mach-O header')
+    magic, cpu, subtype, filetype, commands, size, flags, reserved = struct.unpack_from('<8I', data)
+    if magic != MACHO64 or cpu != ARM64:
+        raise ValueError('Expected a thin arm64 Mach-O for a physical iPhone')
+    offset = 32
+    platform = None
+    for _ in range(commands):
+        if offset + 8 > len(data):
+            raise ValueError('Truncated Mach-O load command')
+        command, length = struct.unpack_from('<II', data, offset)
+        if length < 8 or offset + length > len(data):
+            raise ValueError('Invalid Mach-O load-command size')
+        if command == LC_CODE_SIGNATURE:
+            if length < 16:
+                raise ValueError('Truncated code-signature command')
+            _, signature_size = struct.unpack_from('<II', data, offset + 8)
+            if signature_size:
+                raise ValueError('IPA still contains a code signature')
+        if command == LC_BUILD_VERSION:
+            if length < 24:
+                raise ValueError('Truncated build-version command')
+            platform = struct.unpack_from('<I', data, offset + 8)[0]
+        offset += length
+    if platform != 2:
+        raise ValueError('Expected iOS device platform; simulator binaries are not installable')
+    return {'architecture': 'arm64', 'platform': 'iOS', 'unsigned': True}
+
+
+def validate(path):
+    with zipfile.ZipFile(path) as archive:
+        names = archive.namelist()
+        if len(names) != len(set(names)):
+            raise ValueError('Duplicate ZIP members')
+        for name in names:
+            parts = pathlib.PurePosixPath(name).parts
+            if not parts or parts[0] != 'Payload' or '..' in parts or name.startswith('/'):
+                raise ValueError('Unsafe IPA member: ' + name)
+            if '_CodeSignature' in parts or parts[-1] == 'embedded.mobileprovision':
+                raise ValueError('Signing metadata found in IPA')
+        apps = [name for name in names if name.count('/') == 2 and name.endswith('.app/Info.plist')]
+        if len(apps) != 1:
+            raise ValueError('IPA must contain exactly one main app')
+        main_path = apps[0].rsplit('/', 1)[0]
+        main = plistlib.loads(archive.read(apps[0]))
+        main_id = main['CFBundleIdentifier']
+        if main.get('CFBundleSupportedPlatforms') != ['iPhoneOS']:
+            raise ValueError('Main app is not an iPhoneOS build')
+        bundles = [name for name in names if name.endswith('/Info.plist')
+                   and (name.rsplit('/', 1)[0].endswith('.app')
+                        or name.rsplit('/', 1)[0].endswith('.appex'))]
+        inspected = []
+        for plist_path in bundles:
+            bundle = plistlib.loads(archive.read(plist_path))
+            prefix = plist_path.rsplit('/', 1)[0]
+            bundle_id = bundle['CFBundleIdentifier']
+            if prefix != main_path and not bundle_id.startswith(main_id + '.'):
+                raise ValueError('Extension Bundle ID is not prefixed by the main app ID')
+            executable = prefix + '/' + bundle['CFBundleExecutable']
+            mode = archive.getinfo(executable).external_attr >> 16
+            if not mode & stat.S_IXUSR:
+                raise ValueError('Executable permission missing: ' + executable)
+            inspected.append({'bundle_id': bundle_id, **macho_info(archive.read(executable))})
+        # Check embedded frameworks and dynamic libraries as well as app executables.
+        for member in archive.infolist():
+            if member.is_dir() or member.file_size < 4:
+                continue
+            with archive.open(member) as stream:
+                magic = stream.read(4)
+            if magic == struct.pack('<I', MACHO64):
+                macho_info(archive.read(member))
+        return {'app': main_id, 'version': main['CFBundleShortVersionString'],
+                'minimum_ios': main['MinimumOSVersion'], 'bundles': inspected}
+
+
+if __name__ == '__main__':
+    try:
+        print(json.dumps(validate(sys.argv[1]), ensure_ascii=False, indent=2))
+    except (ValueError, KeyError, zipfile.BadZipFile, OSError, plistlib.InvalidFileException) as error:
+        raise SystemExit('IPA validation failed: ' + str(error)) from error
