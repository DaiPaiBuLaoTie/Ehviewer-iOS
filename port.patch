index 0000000..de09b71
--- /dev/null
+++ b/Scripts/build-unsigned.sh
@@ -0,0 +1,24 @@
+#!/bin/bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+BUILD_ROOT="${BUILD_ROOT:-$ROOT/build}"
+mkdir -p "$BUILD_ROOT/logs" "$BUILD_ROOT/artifacts"
+cd "$ROOT"
+python3 Scripts/verify-source.py
+xcodebuild archive \
+  -project EhPanda.xcodeproj -scheme EhPanda -configuration Release \
+  -destination 'generic/platform=iOS' \
+  -archivePath "$BUILD_ROOT/EhViewer-SXJ.xcarchive" \
+  -derivedDataPath "$BUILD_ROOT/DerivedData" \
+  -clonedSourcePackagesDirPath "$BUILD_ROOT/SourcePackages" \
+  -onlyUsePackageVersionsFromResolvedFile \
+  -skipMacroValidation -skipPackagePluginValidation \
+  -resultBundlePath "$BUILD_ROOT/Archive.xcresult" \
+  ARCHS=arm64 ONLY_ACTIVE_ARCH=NO \
+  CODE_SIGN_IDENTITY= CODE_SIGN_ENTITLEMENTS= \
+  CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO DEVELOPMENT_TEAM= \
+  CURRENT_PROJECT_VERSION="${GITHUB_RUN_NUMBER:-1}" \
+  2>&1 | tee "$BUILD_ROOT/logs/archive.log"
+bash Scripts/package-unsigned.sh \
+  "$BUILD_ROOT/EhViewer-SXJ.xcarchive/Products/Applications/EhPanda.app" \
+  "$BUILD_ROOT/artifacts/EhViewer-SXJ-iOS-unsigned.ipa"
diff --git a/Scripts/clean-staged-app.py b/Scripts/clean-staged-app.py
new file mode 100644
index 0000000..dac4103
--- /dev/null
+++ b/Scripts/clean-staged-app.py
@@ -0,0 +1,15 @@
+"""Remove signing metadata from a temporary Payload copy only."""
+import pathlib
+import shutil
+import sys
+
+payload = pathlib.Path(sys.argv[1]).resolve(strict=True)
+if payload.name != 'Payload' or not payload.parent.name.startswith('ipa-stage.'):
+    raise SystemExit('Refusing to clean a non-staging directory')
+for path in sorted(payload.rglob('*'), key=lambda item: len(item.parts), reverse=True):
+    if path.is_symlink():
+        continue
+    if path.name == '_CodeSignature' and path.is_dir():
+        shutil.rmtree(path)
+    elif path.name == 'embedded.mobileprovision' and path.is_file():
+        path.unlink()
diff --git a/Scripts/package-unsigned.sh b/Scripts/package-unsigned.sh
new file mode 100644
index 0000000..b59a7cf
--- /dev/null
+++ b/Scripts/package-unsigned.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+APP_PATH="${1:?Usage: package-unsigned.sh app-path output-ipa}"
+OUTPUT="${2:?Specify output IPA}"
+[[ -d "$APP_PATH" && -f "$APP_PATH/Info.plist" ]] || { echo 'Missing archived app' >&2; exit 1; }
+mkdir -p "$(dirname "$OUTPUT")"
+OUTPUT_DIR="$(cd "$(dirname "$OUTPUT")" && pwd)"
+OUTPUT="$OUTPUT_DIR/$(basename "$OUTPUT")"
+STAGING="$(mktemp -d "$OUTPUT_DIR/ipa-stage.XXXXXX")"
+trap 'rm -rf -- "$STAGING"' EXIT
+mkdir "$STAGING/Payload"
+ditto "$APP_PATH" "$STAGING/Payload/EhPanda.app"
+# Strip only the temporary copy, preserving the original archive.
+find "$STAGING/Payload" -depth -type d \( -name '*.app' -o -name '*.appex' -o -name '*.framework' \) -print0 |
+  while IFS= read -r -d '' bundle; do
+    if codesign -dv "$bundle" >/dev/null 2>&1; then
+      codesign --remove-signature "$bundle"
+    fi
+  done
+find "$STAGING/Payload" -type f -name '*.dylib' -print0 |
+  while IFS= read -r -d '' library; do
+    if codesign -dv "$library" >/dev/null 2>&1; then
+      codesign --remove-signature "$library"
+    fi
+  done
+python3 "$ROOT/Scripts/clean-staged-app.py" "$STAGING/Payload"
+(cd "$STAGING" && /usr/bin/zip -q -r -y "$STAGING/output.ipa" Payload)
+mv "$STAGING/output.ipa" "$OUTPUT"
+python3 "$ROOT/Scripts/verify-ipa.py" "$OUTPUT"
+python3 "$ROOT/Scripts/write-build-info.py" "$OUTPUT"
